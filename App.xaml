<?xml version = "1.0" encoding = "UTF-8" ?>
<Application
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="StudyFlow.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FormBorder" TargetType="Border">
                <Setter Property="Margin" Value="30,0,30,10" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="HeightRequest" Value="60" />
                <Setter Property="Stroke" Value="#C8C0B0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="BackgroundColor" Value="#FFFFFF" />
            </Style>

            <Style x:Key="FormEntry" TargetType="Entry">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="#1B2A4A" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="FontFamily" Value="OpenSansRegular" />
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#C9A84C" />
                <Setter Property="TextColor" Value="#1B2A4A" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HeightRequest" Value="50" />
                <Setter Property="Margin" Value="30,0,30,0" />
            </Style>

            <Style x:Key="AssignmentCard" TargetType="Border">
                <Setter Property="Margin" Value="15,7" />
                <Setter Property="Padding" Value="15" />
                <Setter Property="BackgroundColor" Value="#FFFFFF" />
                <Setter Property="Stroke" Value="#C8C0B0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="StrokeThickness" Value="1" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>