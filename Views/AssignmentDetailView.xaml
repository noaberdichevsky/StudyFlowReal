<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StudyFlow.Views.AssignmentDetailView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StudyFlow.ViewModels"
    xmlns:models="clr-namespace:StudyFlow.Model"
    x:DataType="vm:AssignmentDetailViewModel"
    BackgroundColor="#F5F0E8"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">

        <!--  Header  -->
        <Grid Grid.Row="0" Padding="20,50,20,20" BackgroundColor="#1B2A4A">
            <Grid ColumnDefinitions="Auto,*">
                <Button BackgroundColor="Transparent" Command="{Binding GoBackCommand}"
                        FontFamily="MaterialIcons" FontSize="24" Text="&#xe5c4;" TextColor="#F5F0E8"
                        VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0" VerticalOptions="Center">
                    <Label Text="{Binding CurrentAssignment.Title}" FontSize="20" FontAttributes="Bold"
                           FontFamily="OpenSansSemibold" TextColor="#F5F0E8" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding CurrentAssignment.Subject}" FontSize="13"
                           TextColor="#C9A84C" FontFamily="OpenSansRegular" />
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <!--  Content  -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="15">

                <!--  Deadline and Score row  -->
                <Grid ColumnDefinitions="*,*">
                    <Border Padding="15" BackgroundColor="#FFFFFF" Stroke="#C8C0B0"
                            StrokeShape="RoundRectangle 12" StrokeThickness="1">
                        <VerticalStackLayout>
                            <Label Text="Deadline" FontSize="11" TextColor="#5C6B8A" />
                            <Label Text="{Binding CurrentAssignment.Deadline}" FontSize="16"
                                   FontAttributes="Bold" TextColor="#1B2A4A" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Margin="10,0,0,0" Padding="15" BackgroundColor="#FFFFFF"
                            Stroke="#C8C0B0" StrokeShape="RoundRectangle 12" StrokeThickness="1">
                        <VerticalStackLayout>
                            <Label Text="Score" FontSize="11" TextColor="#5C6B8A" />
                            <Label Text="{Binding ScoreDisplay}" FontSize="16"
                                   FontAttributes="Bold" TextColor="#1B2A4A" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!--  Add Score - only for local assignments  -->
                <Border
                    Padding="15"
                    BackgroundColor="#FFFFFF"
                    Stroke="#C8C0B0"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1"
                    IsVisible="{Binding IsLocalAssignment}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Add Score" FontSize="14" FontAttributes="Bold" TextColor="#1B2A4A" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Border Padding="10,5" Stroke="#C8C0B0" StrokeShape="RoundRectangle 8"
                                    StrokeThickness="1" BackgroundColor="#F5F0E8">
                                <Entry Placeholder="e.g. 85" PlaceholderColor="#9AA5B8"
                                       Text="{Binding LocalScore}" Keyboard="Numeric"
                                       FontSize="14" TextColor="#1B2A4A" BackgroundColor="Transparent" />
                            </Border>
                            <Button Grid.Column="1" Margin="8,0,0,0" BackgroundColor="#1B2A4A"
                                    Command="{Binding SaveScoreCommand}" CornerRadius="8"
                                    FontAttributes="Bold" FontSize="14" HeightRequest="45"
                                    Text="Save" TextColor="#F5F0E8" WidthRequest="70" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!--  Progress Bar  -->
                <Border Padding="15" BackgroundColor="#FFFFFF" Stroke="#C8C0B0"
                        StrokeShape="RoundRectangle 12" StrokeThickness="1">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Progress" FontSize="14" FontAttributes="Bold" TextColor="#1B2A4A" />
                            <Label Grid.Column="1" Text="{Binding CompletionProgress, StringFormat='{0:P0}'}"
                                   FontSize="14" FontAttributes="Bold" TextColor="#C9A84C" />
                        </Grid>
                        <ProgressBar Progress="{Binding CompletionProgress}"
                                     ProgressColor="#C9A84C" BackgroundColor="#EDE8DC" />
                    </VerticalStackLayout>
                </Border>

                <!--  Description  -->
                <Border Padding="15" BackgroundColor="#FFFFFF" Stroke="#C8C0B0"
                        StrokeShape="RoundRectangle 12" StrokeThickness="1">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Description" FontSize="14" FontAttributes="Bold" TextColor="#1B2A4A" />
                        <Label Text="{Binding CurrentAssignment.Description}" FontSize="14"
                               TextColor="#5C6B8A" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <!--  Guidance  -->
                <Border Padding="15" BackgroundColor="#FFFFFF" Stroke="#C8C0B0"
                        StrokeShape="RoundRectangle 12" StrokeThickness="1">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Guidance" FontSize="14" FontAttributes="Bold" TextColor="#1B2A4A" />
                        <Label Text="{Binding CurrentAssignment.Guidance}" FontSize="14"
                               TextColor="#5C6B8A" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <!--  Subtasks  -->
                <Border Padding="15" BackgroundColor="#FFFFFF" Stroke="#C8C0B0"
                        StrokeShape="RoundRectangle 12" StrokeThickness="1">
                    <VerticalStackLayout Spacing="10">

                        <Label Text="Subtasks" FontSize="14" FontAttributes="Bold" TextColor="#1B2A4A" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding SubtaskList}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:SubTask">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                  Color="#C9A84C" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding Title}" FontSize="14"
                                               TextColor="#1B2A4A" VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                    <Setter Property="TextColor" Value="#9AA5B8" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" BackgroundColor="#C8C0B0" Margin="0,5,0,5" />

                        <Label Text="Add your own step" FontSize="13" TextColor="#5C6B8A" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Border Padding="10,5" Stroke="#C8C0B0" StrokeShape="RoundRectangle 8"
                                    StrokeThickness="1" BackgroundColor="#F5F0E8">
                                <Entry Placeholder="e.g. Ask teacher for help" PlaceholderColor="#9AA5B8"
                                       Text="{Binding NewSubtaskTitle}" FontSize="14"
                                       TextColor="#1B2A4A" BackgroundColor="Transparent" />
                            </Border>
                            <Button Grid.Column="1" Margin="8,0,0,0" BackgroundColor="#C9A84C"
                                    Command="{Binding AddSubtaskCommand}" CornerRadius="8"
                                    FontAttributes="Bold" FontSize="14" HeightRequest="45"
                                    Text="Add" TextColor="#1B2A4A" WidthRequest="60" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>