<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StudyFlow.Views.SignUpView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StudyFlow.ViewModels"
    x:DataType="vm:SignUpViewModel"
    NavigationPage.HasNavigationBar="False">

    <!--  Local styles for this page  -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="FormBorder" TargetType="Border">
                <Setter Property="Margin" Value="30,0,30,10" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="HeightRequest" Value="60" />
                <Setter Property="Stroke" Value="#C8C0B0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="BackgroundColor" Value="#FFFFFF" />
            </Style>
            <Style x:Key="FormEntry" TargetType="Entry">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="#1B2A4A" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#C9A84C" />
                <Setter Property="TextColor" Value="#1B2A4A" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HeightRequest" Value="50" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!--  Deep navy gradient background  -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.0" Color="#1B2A4A" />
            <GradientStop Offset="1.0" Color="#111D33" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <ScrollView>
            <VerticalStackLayout
                Padding="30"
                Spacing="5"
                VerticalOptions="Center">

                <!--  Title  -->
                <Label
                    Text="Create Account"
                    FontSize="28"
                    FontAttributes="Bold"
                    FontFamily="OpenSansSemibold"
                    TextColor="#F5F0E8"
                    HorizontalOptions="Center"
                    Margin="0,30,0,5"/>

                <!--  Subtitle  -->
                <Label
                    FontSize="14"
                    HorizontalOptions="Center"
                    Text="Join StudyFlow today"
                    TextColor="#C9A84C"
                    FontFamily="OpenSansRegular"
                    Margin="0,0,0,20"/>

                <!--  Error Message  -->
                <Label
                    FontSize="14"
                    HorizontalTextAlignment="Center"
                    IsVisible="{Binding SignUpMessageVisible}"
                    Text="{Binding ErrorMessage}"
                    TextColor="#E74C3C"
                    Margin="0,0,0,10"/>

                <!--  First Name  -->
                <Border Style="{StaticResource FormBorder}">
                    <Entry
                        Style="{StaticResource FormEntry}"
                        Placeholder="First Name"
                        PlaceholderColor="#9AA5B8"
                        Text="{Binding FName}" />
                </Border>

                <!--  Last Name  -->
                <Border Style="{StaticResource FormBorder}">
                    <Entry
                        Style="{StaticResource FormEntry}"
                        Placeholder="Last Name"
                        PlaceholderColor="#9AA5B8"
                        Text="{Binding LName}" />
                </Border>

                <!--  Email  -->
                <Border Style="{StaticResource FormBorder}">
                    <Entry
                        Style="{StaticResource FormEntry}"
                        Keyboard="Email"
                        Placeholder="Email"
                        PlaceholderColor="#9AA5B8"
                        Text="{Binding UEmail}" />
                </Border>

                <!--  Password  -->
                <Border Style="{StaticResource FormBorder}">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Entry
                            Style="{StaticResource FormEntry}"
                            IsPassword="{Binding EntryAsPassword}"
                            Placeholder="Password (min 6 characters)"
                            PlaceholderColor="#9AA5B8"
                            Text="{Binding UPassword}" />
                        <Button
                            Grid.Column="1"
                            Padding="0"
                            BackgroundColor="Transparent"
                            Command="{Binding TogglePasswordCommand}"
                            FontFamily="MaterialIcons"
                            FontSize="22"
                            Text="{Binding PasswordIconCode}"
                            TextColor="#5C6B8A" />
                    </Grid>
                </Border>

                <!--  Mobile  -->
                <Border Style="{StaticResource FormBorder}">
                    <Entry
                        Style="{StaticResource FormEntry}"
                        Keyboard="Telephone"
                        Placeholder="Mobile (10 digits)"
                        PlaceholderColor="#9AA5B8"
                        Text="{Binding UMobile}" />
                </Border>

                <!--  Sign Up Button  -->
                <Button
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding SignUpCommand}"
                    Text="Create Account"
                    Margin="30,10,30,0"/>

                <!--  Navigate to Sign In  -->
                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Margin="0,10,0,30">
                    <Label
                        Text="Already have an account?"
                        TextColor="#C8C0B0"
                        FontSize="14"
                        VerticalTextAlignment="Center" />
                    <Button
                        BackgroundColor="Transparent"
                        Command="{Binding NavigateToSignInCommand}"
                        FontSize="14"
                        Text="Sign In"
                        TextColor="#C9A84C" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!--  Loading Spinner  -->
        <Grid
            HorizontalOptions="Fill"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Fill">
            <BoxView
                BackgroundColor="#1B2A4A"
                HorizontalOptions="Fill"
                Opacity="0.7"
                VerticalOptions="Fill" />
            <ActivityIndicator
                IsRunning="True"
                Color="#C9A84C"
                WidthRequest="60" />
        </Grid>

    </Grid>
</ContentPage>